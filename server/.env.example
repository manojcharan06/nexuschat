PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB URI (Update with local or MongoDB Atlas string)
MONGODB_URI=mongodb://127.0.0.1:27017/nexuschat

# Authentication Secrets
JWT_ACCESS_SECRET=nexuschat_access_secret_key_change_in_production_32bytes
JWT_REFRESH_SECRET=nexuschat_refresh_secret_key_change_in_production_32bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
