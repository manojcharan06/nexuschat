# Dependencies
node_modules/
**/node_modules/

# Next.js & Build output
client/.next/
client/out/
dist/
build/

# Environment files (ignore all .env files recursively everywhere)
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env

# Allow safe template/example files to be tracked
!**/.env.example
!**/.env.sample
!**/*.env.example
!**/*.env.sample

# Logs & OS metadata
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
